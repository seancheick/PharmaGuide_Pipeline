{
  "_metadata": {
    "batch_id": "probiotic_identity_batch_2026_09_14",
    "created_on": "2026-09-14",
    "registry": "scripts/data/clinically_relevant_strains.json",
    "method": "PubMed title/abstract (E-utilities) and Europe PMC open-access full text read for each designation, species and deposit. A designation is added only when a published source names it with its species; manufacturer-authored methods sections are preferred for deposit crosswalks. No label-only identities are added in this batch.",
    "scope_rules": [
      "merge_duplicate: a registry stub whose deposit number is published by the manufacturer (or by at least two independent sources, none conflicting) as the same strain as an existing named identity is folded into that identity; the stub had no study contexts.",
      "add_alias: punctuation, spacing, the word 'strain', a label misspelling of the species, a manufacturer synonym stated by a source (Rosell-52 = R0052), or a deposit number stated by the manufacturer.",
      "add_identity: species plus designation named together in a published source. designation_found_species_unconfirmed is used when sources disagree on the species name for the same designation (taxonomic renaming); such identities earn the label identity credit but are not accepted for research presentation by identity_confidence().",
      "Nothing in this batch changes dr_pham_signoff, study_contexts, evidence, or dose tiers."
    ],
    "held_unresolved": {
      "Bifidobacterium breve BB-3 / Bb-3 / Br-3": "Not the printed DuPont designation Bb-03; 'BB-3' is published for a different strain (Morinaga B. breve B-3, PMID 36615686).",
      "Bifidobacterium bifidum BB-6, Bifidobacterium longum BL-5, L. acidophilus LA-1 / LA-2": "Not the exact published designation (Bb-06, Bl-05, La-14/LA02); a zero-dropped code is not proof of identity.",
      "Bifidobacterium bifidum/lactis Bb-02 (all slash or animalis-lactis variants)": "The label names two species; Bb-02 is published as B. bifidum BB-02 (PMID 14630592) and as B. longum subsp. infantis BB-02 (ESPGHAN neonatal combination, PMID 41913515). Label is self-contradictory.",
      "Bifidobacterium bifidum (SD-6575)": "Literature publishes B. bifidum ATCC SD6576; SD-6575 appears in no source.",
      "Lactobacillus brevis SD-5214 merge": "Sources conflict: Levilactobacillus brevis Lbr-35 (ATCC SD5214) in a product table (PMID 35875231) vs L. acidophilus ATCC SD5214 (PMID 34769015). Stub kept as is.",
      "Lactococcus lactis SD-5584 merge": "Only a product-label table (PMID 35875231) ties SD5584 to Ll-23; the manufacturer table (PMID 35634575) lists Ll-23 as DGCC8656. Stub kept as is.",
      "SD-1357, SD-2468, SD-5685, SD-5839, SD-5845, SD-5847, SD-5857": "No published source names these deposits with a strain.",
      "Bifidobacterium breve UABbr-11 / Bb-18, Bifidobacterium infantis NI313, L. reuteri JBD 301, CUL-06/67/73/74, UAS UALxx codes, DSM-numbered labels, SP54": "No published source names the designation with the printed species.",
      "Bifidobacterium lactis Bi-04, Bifidobacterium longum Bi-05, Bifidobacterium lactis Bl-07, UABi-14, UABia-12, R-11, R-52, Rosell-52nd, rhamnosus-111 and other HA numbers without the HA prefix": "Typo-level variants of a real code; not the exact designation.",
      "Lactobacillus plantarum Lp299": "299 and 299v are distinct Probi strains.",
      "B. bifidum BB-12, Bifidobacterium longum subsp. longum 35624": "Label species contradicts the published strain (BB-12 is B. animalis subsp. lactis; 35624 is B. longum subsp. infantis).",
      "Seed DS-01 SD-*-IT / -JP / -BE / -SP / -FR / -US codes": "Formula-level Seed records; one product; outside strain-level scope.",
      "Lab4 NCIMB deposit correction": "Applied on manufacturer-authored consensus; NCIMB catalogue page unreadable (see op note)."
    }
  },
