":"other","ingredientGroup":"Flavor","uniiCode":null,"alternateNames":[],"forms":[]},{"order":4,"ingredientId":278811,"name":"Citric Acid","category":"non-nutrient/non-botanical","ingredientGroup":"Citric Acid","uniiCode":"2968PHW8QP","alternateNames":[],"forms":[]}]},"pdf":"304687_document.pdf","percentDvFootnote":"Percent Daily Values (DV) are based on a 2,000 calorie diet.","physicalState":{"langualCode":"E0165","langualCodeDescription":"Liquid"},"productType":{"langualCode":"A1325","langualCodeDescription":"Other Combinations"},"productVersionCode":"LG13316.04 BLQ9230","servingSizes":[{"order":1,"minQuantity":7.5,"maxQuantity":7.5,"minDailyServings":1,"maxDailyServings":1,"unit":"mL","notes":"4-5 years of age, 1 1/2 teaspoons (tsp)","inSFB":true},{"order":2,"minQuantity":7.5,"maxQuantity":15,"minDailyServings":1,"maxDailyServings":1,"unit":"mL","notes":"6 to 17 years of age"},{"order":3,"minQuantity":15,"maxQuantity":15,"minDailyServings":1,"maxDailyServings":1,"unit":"mL","notes":"Adults, 18 years of age and older","inSFB":true}],"servingsPerContainer":"8","src":"api/label/304687","statements":[{"type":"Suggested/Recommended/Usage/Directions","notes":"Recommendation:\r\nDosage cup included. Shake well before each use. For children 4-5 years of age, consult a physician before use, do not exceed 1 1/2 teaspoons (tsp) (7.5 mL). For children 6 to 17 years of age, start with 1 1/2 teaspoons (7.5 mL) and give up to 3 teaspoons (15 mL) as needed. Administer to children 30-60 minutes before bedtime.\r\nFor children: Do not use for more than 14 consecutive days unless directed by a physician. Adults, 18 years of age and older, take 3 teaspoons (15 mL) 30-60 minutes before bedtime. Take only as directed."},{"type":"Precautions re: All Other","notes":"Do not exceed recommended dose.\r\nThis product may cause drowsiness, do not drive, or operate machinery while taking this product. Avoid alcohol and other sedatives while taking this product. If irritations persist or worsen, stop use and consult a healthcare professional. If you, or your child, are experiencing long-term sleep difficulties, consult a physician."},{"type":"Precautions re: Children","notes":"Not formulated for children under 4 years of age.\r\nKeep out of reach of children."},{"type":"Precautions re: Pregnant or Nursing or Prescription Medications","notes":"Warning: Do not use if you are pregnant, attempting to become pregnant, nursing, or if you have or are being treated for depression or dementia. If you are being treated for diabetes, autoimmune, endocrine, blood clotting, or seizure disorders, or if you are taking any medications, consult a physician before use. If your child is taking any medications, has a medical condition, or chronic disease, consult a physician before use."},{"type":"Precautions re: All Other","notes":"Do not use if safety seal under child-resistant cap is broken or missing."},{"type":"Storage","notes":"Keep tightly closed. Store at room temperature. Avoid excessive heat and direct sunlight."},{"type":"Formulation re: Does NOT Contain","notes":"Gluten free\r\nContains no dairy, soy, peanut, or artificial colors."},{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"Copyright 2023 Distributed by Nature's Way Brands, LLC"},{"type":"General Statements: All Other Content","notes":"Questions? 1-800-9Nature / naturesway.com"},{"type":"Formulation re: Vegetarian/Vegan","notes":"Vegetarian"},{"type":"FDA Disclaimer Statement","notes":"These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease."},{"type":"Formula re: Contains","notes":"Made from 3,200 mg of elderberries per 3-tsp serving\r\nSix key ingredients\r\nMelatonin for occasional sleeplessness\r\nEnglish ivy to soothe occasional coughs\r\nFor coughs associated with hoarseness, dry throat, & irritants"},{"type":"Formula re: Type","notes":"For the whole family ages 4+"},{"type":"FDA Statement of Identity","notes":"Dietary Supplement"},{"type":"General Statements: All Other Content","notes":"Servings per container 16, 8"}],"targetGroups":["Children 4 or More Years of Age","Vegetarian","Adult (18 - 50 Years)","Gluten Free","Dairy Free"],"thumbnail":"304687_thumbnail.jpg","upcSku":"","userGroups":[{"dailyValueTargetGroupName":"Adults and children 4 or more years of age","langualCode":"P0250","langualCodeDescription":"Adults and Children 4 years and above"}],"_source":"api"}