  "statements": [
    {
      "type": "Brand IP Statement(s) re: (c), (TM), (SM)",
      "notes": "Pro Performance Results"
    },
    {
      "type": "Formula re: Contains",
      "notes": "Complete Vegan Gainer is an all-in-one performance formula with 550 calories from 17 plant-based sources and whole-food-based blends.  This formula provides 50 grams of complete protein, a protein that gives you all 9 essential amino acids in amounts appropriate for you nutrition."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "Whether you want to gain muscle or satisfy your hunger, you can use this delicious protein to meet your nutritional needs."
    },
    {
      "type": "Formula re: Contains",
      "notes": "This performance gainer provides 9 grams of branched chain amino acids (BCAA) to help fuel muscles, along with key amino acids glutamine and glutamic acid to support immune response. Complete Vegan Gainer also has 70 grams of clean, maltodextrin-free carbs featuring ancient grains and 8 grams of hunger-satisfying fiber."
    },
    {
