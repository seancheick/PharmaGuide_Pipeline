ernateNames":[],"forms":[]},{"order":10,"ingredientId":28795,"name":"Caramel color","category":"other","ingredientGroup":"Color","uniiCode":null,"alternateNames":[],"forms":[]}]},"pdf":"","percentDvFootnote":"Percent Daily Values are based on a 2,000 calorie diet.","physicalState":{"langualCode":"E0162","langualCodeDescription":"Powder"},"productType":{"langualCode":"A1325","langualCodeDescription":"Other Combinations"},"productVersionCode":"CODE 386562 DUG","servingSizes":[{"order":1,"minQuantity":62.5,"maxQuantity":62.5,"minDailyServings":1,"maxDailyServings":2,"unit":"Gram(s)","notes":"2 scoops","inSFB":true}],"servingsPerContainer":"33","src":"api/label/243050","statements":[{"type":"General Statements: All Other Content","notes":"30% increase in muscle strength in just 8 weeks\nAn 8-week, randomized, double-blind, placebo-controlled study of 33 healthy men compared the effectiveness of this proprietary module of whey protein and leucine vs. an isocaloric carbohydrate placebo consumed before and after resistance training. Subjects consuming the leucine-whey protein supplement experienced greater increases in muscle strength than those on the placebo. Leucine-whey protein supplementation also increased muscle cross-sectional area from baseline.\nIn an 8-week, randomized, double-blind, placebo-controlled study of 30 healthy male volunteers comparing 1 set resistance training (RT) + active or carbohydrate placebo to 2 sets RT alone with no supplement, the active group showed equal gains in maximal muscle strength and muscle endurance compared to the control group.\nIn a randomized, double-blind, crossover clinical trial that included 20 recreationally trained, healthy male subjects, those taking 10g whey protein isolate plus 10g leucine immediately post-workout showed significant increases in key protein (p70S6k & rpS6) associated with muscle protein synthesis."},{"type":"Seals/Symbols","notes":"Informed Choice.org\nTrusted by sport"},{"type":"Formulation re: Other","notes":"Products bearing this logo have been tested for banned substances by LGC Science, Inc., a world-class anti-doping lab.\nProduct was tested for over 220 banned substances on the 2019 World Anti-Doping Agency (WADA) Prohibited List via LGC skip lot testing protocol #ICP0307."},{"type":"FDA Disclaimer Statement","notes":"These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease."},{"type":"Precautions re: Children","notes":"Keep out of reach of children."},{"type":"Storage","notes":"Store in a cool, dry place."},{"type":"General Statements: All Other Content","notes":"For more information: 1-888-462-2548\nGNC.com"},{"type":"Formulation re: Other","notes":"Proven to increase muscle strength and size in just 8 weeks"},{"type":"Formula re: Contains","notes":"Ultra-Pure, fast digesting whey protein isolate & hydrolysates\nClinically proven performance protein\n40g Protein\n15g BCAA\n10g Leucine\n1g Velositol\nPer 2 Scoops\nChocolate Fudge natural + artificial flavors"},{"type":"FDA Statement of Identity","notes":"Dietary Supplement"},{"type":"Suggested/Recommended/Usage/Directions","notes":"Directions: As a dietary supplement, consume 2 scoops in 8 fl.oz. of cold water or your favorite beverage. Wheybolic can be consumed first thing in the morning, pre-workout and/or post-workout. For maximum results, reference usage benefits and consume 2 scoops twice daily."},{"type":"General Statements: All Other Content","notes":"Servings per container 66 33"},{"type":"Precautions re: Allergies","notes":"Contains: Milk and soybeans."},{"type":"Precautions re: Pregnant or Nursing or Prescription Medications","notes":"Warning: Consult your physician prior to using this product if you are pregnant, nursing, taking medication, or have a medical condition."},{"type":"Precautions re: All Other","notes":"Discontinue use two weeks prior to surgery."},{"type":"Formulation re: Does NOT Contain","notes":"Gluten free."},{"type":"Precautions re: All Other","notes":"Notice: Use this product as a food supplement only. Do not use for weight reduction."},{"type":"General Statements: All Other Content","notes":"Significant product settling may occur."},{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"ProHydrolase is a trademark of Deerland Enzymes, Inc.\nVelositol and its associated logo is a trademark of nutrition 21, LLC. Velositol is patent protected."},{"type":"Seals/Symbols","notes":"Banned Substance Free"},{"type":"Formula re: Contains","notes":"Superior performance protein\nEnhanced with more leucine & BCAA than standard whey protein\nElevated muscle fuel with a premium 4:1:1 BCAA Ratio for muscle growth & recovery\nFeatures only premium, ultra-pure, fast-absorbing protein\nOnly whey hydrolysates and a clinical core of whey isolate & leucine to improve strength & post-training anabolic response\nEnhanced with velositol & prohydrolase\nTo accelerate muscle protein synthesis & absorption of amino acids for efficient use by muscles"},{"type":"Formulation re: Other","notes":"Usage Benefits\nFor pre-workout & cardio\nClinically proven support for strength, performance & stamina"},{"type":"Formula re: Contains","notes":"For post-workout & cardio\nProvides Fast-absorbing Whey Isolate & Hydrolysates Plus BCAA to Fuel Anabolic Muscle Support & Recovery\nOn non-training days & between meals\nProvides High-Quality Protein & Critical Amino Acids to Fuel Muscles while you Recover from Intense Training"},{"type":"Formulation re: Other","notes":"If it's on our labels, then it's in our bottles. Full dosing, full transparency and no proprietary blends. Clinically studied ingredients backed by real science. The most effective and premium performance protein available. Train harder."}],"targetGroups":["Adult (18 - 50 Years)","Gluten Free"],"thumbnail":"","upcSku":"0 48107 18230 4","userGroups":[{"dailyValueTargetGroupName":"Adults and children 4 or more years of age","langualCode":"P0250","langualCodeDescription":"Adults and Children 4 years and above"}],"_source":"api"}