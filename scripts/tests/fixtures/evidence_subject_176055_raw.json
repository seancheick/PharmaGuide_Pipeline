ientId":4025,"name":"Lecithin","category":"fat","ingredientGroup":"lecithin","uniiCode":null,"alternateNames":[],"forms":[]},{"order":8,"ingredientId":3794,"name":"Sucralose","category":"non-nutrient/non-botanical","ingredientGroup":"Sucralose","uniiCode":null,"alternateNames":[],"forms":[]},{"order":9,"ingredientId":4728,"name":"Acesulfame Potassium","category":"non-nutrient/non-botanical","ingredientGroup":"Acesulfame potassium","uniiCode":null,"alternateNames":[],"forms":[]},{"order":10,"ingredientId":6906,"name":"Red #40 Lake","category":"other","ingredientGroup":"Color","uniiCode":null,"alternateNames":[],"forms":[]}]},"pdf":"","percentDvFootnote":"Percent Daily Values are based on a 2,000 calorie diet.","physicalState":{"langualCode":"E0162","langualCodeDescription":"Powder"},"productType":{"langualCode":"A1325","langualCodeDescription":"Other Combinations"},"productVersionCode":"CODE 386521 ASG","servingSizes":[{"order":1,"minQuantity":31.5,"maxQuantity":63,"minDailyServings":1,"maxDailyServings":1,"unit":"Gram(s)","notes":"1-2 scoops","inSFB":true}],"servingsPerContainer":"20","src":"api/label/176055","statements":[{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"Performance improvement\nAmplified Creatine XXX\nCarbohydrate only\nPercent improvement\nBench press\nVertical jump\n100 yard dash\n\t"},{"type":"General Statements: All Other Content","notes":"^In one study, eight weeks of supplementation with this product's creatine and carbohydrate blend in male collegiate athletes during off-season training produced a 12.9% increase in bench press, 8.4% increase in vertical jump and a 2.6% improvement in 100 yard dash performance compared to those taking only carbohydrates who experienced a 4.5%, 1.1% and 0.4% improvement, respectively. Another randomized, controlled, cross-over clinical study including healthy adults that examined the benefits of consuming the specific blend of amino acids and carbohydrates in this formula before exercise resulted in dramatic increase in amino acid delivery to the leg muscles.\nPer 2 scoop serving\nWhen used in conjunction with an exercise program."},{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"In a radomized, double-blind, placebo-controlled, crossover study, 19 volunteers consumed 3 doses of Resvida (30mg, 90 mg, 270 mg) and a placebo at weekly intervals."},{"type":"General Statements: All Other Content","notes":"Flow-mediated dilatation (FMD) of the brachial artery was measured one hour after ingestion of each treatment and was significally increased at all 3 doses relative to placebo. 30 mg of Resvida demonstrated 2.5% greater increase in FMD relative to placebo."},{"type":"Formula re: Contains","notes":"30 mg of Resvida demonstrated 2.5% greater increase in FMD relative to placebo."},{"type":"Precautions re: Children","notes":"Keep out of reach of children."},{"type":"Storage","notes":"Store in a cool, dry place."},{"type":"General Statements: All Other Content","notes":"- Enhances strength & performance\n- Clinically shown to increase upper body strength by 12.9%\n- Maximizes post-workout recovery with Glycogen-loading carbs"},{"type":"Formula re: Contains","notes":"10g Creatine matrix\n7g Amino complex\n33g fast-acting Dextrose"},{"type":"General Statements: All Other Content","notes":"Natural + artificial flavors"},{"type":"Seals/Symbols","notes":"Banned Substance Free"},{"type":"FDA Statement of Identity","notes":"Dietary Supplement"},{"type":"General Statements: All Other Content","notes":"AMP"},{"type":"General: Product/Version Code","notes":"CODE 386521 ASG"},{"type":"Suggested/Recommended/Usage/Directions","notes":"Directions: As a dietary supplement, mix one to two scoops with 4-8 fl. oz. water, before, during or after your workout. On non-training days, take immediately upon waking up in the morning. Consume ample amounts of water while taking this product."},{"type":"Formula re: Contains","notes":"Contains: Soybeans."},{"type":"Precautions re: Allergies","notes":"Contains: Soybeans."},{"type":"Precautions re: Pregnant or Nursing or Prescription Medications","notes":"Warning: Conuslt your physician prior to using this product if you are pregnant, nursing, taking medication, under 18 years of age or have a medical condition."},{"type":"Precautions re: Children","notes":"Warning: Conuslt your physician prior to using this product if you are pregnant, nursing, taking medication, under 18 years of age or have a medical condition.\t\n"},{"type":"Precautions re: All Other","notes":"Discontinue use two weeks prior to surgery."},{"type":"General Statements: All Other Content","notes":"Notice: Significant product settling may occur."},{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"resVida is a trademark of DSM."},{"type":"Seals/Symbols","notes":"Informed-choice.org\nTrusted by sport"},{"type":"General Statements: All Other Content","notes":"Products bearing this logo have been tested for banned substances by LGC Science, Inc., a world-class anti-doping lab. Product was tested for over 145 banned substances on the 2017 World Anti-Doping Agency (WADA) Prohibited List via LGC skip lot testing protocol #ICP0307. See gnc.com for more information."},{"type":"FDA Disclaimer Statement","notes":"These statements have not been evaluate by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease."},{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"What is Amplified Creatine XXX?"},{"type":"Formula re: Contains","notes":"This is creatine supplementation on another level. The advanced formula delivers accelerated fuel for a power-driven performance by supplying three critical components to training - Creatine, Amino Acids and Carbohydrates - designed for extreme athletes striving to go beyond their maximum potential. Creatine helps fuel skeletal muscles and provides support for immediate energy during high-intensity workouts, while amino acids are involved in protein synthesis for muscle growth and repair. For post-workout recovery and energy, Amplified Creatine XXX is infused with 33 grams of a fast-acting carbohydrate, dextrose, to help spike insulin and stimulate the uptake of aminos. The overall innovation is a superior performance complex of amino acids, including branched chain amino acids (BCAA) and carbohydrates to help reduce muscle protein breakdown and push your intense training to a new level."},{"type":"General Statements: All Other Content","notes":"Where's the proof?\nNumerous studies have shown the benefits of creatine and amino acids for training athletes. Our researchers have taken the science and developed a powerhouse creatine formula to maximize the improvement of athletic performance, cellular hydration and muscle repair."},{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"Amplified Creatine XXX is clinically shown to increase bench press, vertical jump and 100 yard dash performance. This powerful formulation also includes the clinically studied resVida trans-Resveratrol, shown to enhance blood vessel dilation, along with 3 grams of micronized Arginine, a precursor for the synthesis of nitric oxide, proteins and creatine."},{"type":"Formula re: Contains","notes":"This powerful formulation also includes the clinically studied resVida trans-Resveratrol, shown to enhance blood vessel dilation, along with 3 grams of micronized Arginine, a precursor for the synthesis of nitric oxide, proteins and creatine."},{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"Who should be taking Amplified Creatine XXX?"},{"type":"General Statements: All Other Content","notes":"This breakthrough performance supplement is for the dedicated, highly competitive fitness warrior who wants that extra edge."},{"type":"Brand IP Statement(s) re: (c), (TM), (SM)","notes":"Amplified Creatine XXX is the next level of athletic performance through effective creatine and amino acid delivery in a single, better-tasting supplement."}],"targetGroups":["Adult (18 - 50 Years)"],"thumbnail":"","upcSku":"0 48107 17003 5","userGroups":[{"dailyValueTargetGroupName":"Adults and children 4 or more years of age","langualCode":"P0250","langualCodeDescription":"Adults and Children 4 years and above"}],"_source":"api"}